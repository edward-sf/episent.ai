{
  "name": "episent-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "dev:api": "wrangler dev -c wrangler.api.jsonc",
    "dev:cron": "wrangler dev -c wrangler.cron.jsonc --test-scheduled",
    "deploy:api": "wrangler deploy -c wrangler.api.jsonc",
    "deploy:cron": "wrangler deploy -c wrangler.cron.jsonc",
    "build:dashboard": "vite build",
    "dev:dashboard": "vite build && wrangler dev -c wrangler.dashboard.jsonc -c wrangler.api.jsonc",
    "deploy:dashboard": "vite build && wrangler deploy -c wrangler.dashboard.jsonc"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "hono": "^4.13.8",
    "leaflet": "^1.9.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "supabase": "^2.117.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
